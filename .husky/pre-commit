#!/usr/bin/env sh
set -eu

git diff --cached --name-only --diff-filter=ACMR -z \
  | grep -z -v -x 'pnpm-lock.yaml' \
  | xargs -0 -r pnpm exec prettier --write --ignore-unknown --

git diff --cached --name-only --diff-filter=ACMR -z \
  | grep -z -v -x 'pnpm-lock.yaml' \
  | xargs -0 -r git add --
