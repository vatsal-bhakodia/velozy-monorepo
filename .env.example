# Shared application data
DATABASE_URL=
INTEGRATION_ENCRYPTION_KEY=
# Platform billing uses Velozy's own Dodo account, separate from project merchant connections.
# Keep test mode until Dodo test checkout and platform webhook verification pass end to end.
DODO_PLATFORM_API_KEY=
DODO_PLATFORM_WEBHOOK_SECRET=
DODO_PLATFORM_MODE=test
# JSON map of Dodo product IDs. Keys: foundation.{launch|scale}.{INR|USD}.{month|year}
# and credits.{ai_100|ai_500|ai_1500|ai_5000}.{INR|USD}.
DODO_PLATFORM_PRODUCTS_JSON=
# Must remain false until staging checkout and webhook verification are complete.
DODO_PLATFORM_LIVE_ENABLED=false
# Generate with: openssl rand -hex 32. Keep this server-only and stable; rotating it makes saved provider credentials unreadable.
REDIS_URL=

# Supabase: only the VITE_* values are exposed to the admin browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=site-media
ADMIN_URL=http://localhost:5173

# Express API
API_PORT=4000
SUPABASE_JWKS_URL=
# Generate with: openssl rand -hex 32. Set the identical server-only value for API and Sites.
GROWTH_INTERNAL_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/growth/google/callback
# Optional paid SEO research through DataForSEO.
# Create an account: https://app.dataforseo.com/register
# API docs: https://docs.dataforseo.com/v3/
# Requests are capped at $1/project and $10/platform per UTC month.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional free Domain Rating lookup. Create/copy an API key from your Ahrefs account:
# https://app.ahrefs.com/user/api-key
# API docs: https://docs.ahrefs.com/en/api/reference/public/get-domain-rating-free
AHREFS_API_KEY=
# Optional Google CrUX and PageSpeed Insights data. Create an API key:
# https://console.cloud.google.com/apis/credentials
# Enable Chrome UX Report API: https://console.cloud.google.com/apis/library/chromeuxreport.googleapis.com
# Enable PageSpeed Insights API: https://console.cloud.google.com/apis/library/pagespeedonline.googleapis.com
GOOGLE_SEO_API_KEY=

# AI generation: choose one provider and fill in its matching key.
# Onboarding section generation requires this after sign-in.
AI_PROVIDER=openai
OPENAI_API_KEY=
# GEMINI_API_KEY=
# Optional model overrides (defaults are configured in apps/api/src/lib/process-prompt.ts).
# OPENAI_CHAT_MODEL=
# OPENAI_CODING_MODEL=
# GEMINI_CHAT_MODEL=
# GEMINI_CODING_MODEL=

# image search via /api/get-image.
PEXELS_API_KEY=

# Service URLs
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:5173
NEXT_PUBLIC_VELOZY_API_URL=http://localhost:4000
# Hostname suffix and port for published sites.
PLATFORM_DOMAIN=localhost:3002
