{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "paths": {
      "@/src/lib/utils": [
        "./src/legacy-lib/utils.ts"
      ],
      "@/components/ui/*": [
        "./components/ui/*.tsx"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/constants/*": [
        "./src/legacy-constants/*"
      ],
      "@/hooks/*": [
        "./src/legacy-hooks/*"
      ],
      "@/lib/*": [
        "./src/legacy-lib/*"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "components/ui"
  ]
}
