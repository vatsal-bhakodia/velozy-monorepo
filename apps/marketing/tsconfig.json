{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "paths": {
      "@/src/lib/utils": ["./lib/utils.ts"],
      "@/app/*": ["./src/app/*"],
      "@/components/ui/*": ["./components/ui/*.tsx"],
      "@/components/color-picker": ["./components/color-picker.tsx"],
      "@/components/*": ["./components/*"],
      "@/constants/website-screenshots": ["./src/constants/website-screenshots"],
      "@/constants/*": ["../builder/src/constants/*"],
      "@/lib/logo-palette": ["../builder/src/lib/logo-palette"],
      "@/lib/*": ["./lib/*"],
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "components/ui"]
}
